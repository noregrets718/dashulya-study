# Скопируй в `.env` и заполни своими значениями. `.env` не коммитится.

# --- Ollama Cloud (OpenAI-совместимый API) ---
# Ключ: https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Модель выбираем на шаге 1; пока можно оставить примером.
AG2_MODEL=gemma4:31b

# Адрес нативного API Ollama (без /v1): облако — https://ollama.com, локально — http://localhost:11434
AG2_BASE_URL=https://ollama.com

# --- Telegram (понадобится с шага 5) ---
# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=
